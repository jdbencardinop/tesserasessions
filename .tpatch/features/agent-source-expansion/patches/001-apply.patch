+		Source:                  "opencode",
+		SessionSnapshotComplete: true,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := db.GetSession(ctx, session.ID); !errors.Is(err, sql.ErrNoRows) {
+		t.Fatalf("complete empty scan should prune session, got %v", err)
+	}
+}
