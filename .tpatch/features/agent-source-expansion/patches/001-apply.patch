+	mustExec(t, db, `INSERT INTO "session" VALUES
+		('orphan', 'orphan', 'Orphan', 'missing', NULL, '/repo', NULL, 1000, 2000, NULL)`)
+	if err := db.Close(); err != nil {
+		t.Fatal(err)
+	}
+	result := (OpenCodeScanner{Database: path}).Scan(context.Background())
