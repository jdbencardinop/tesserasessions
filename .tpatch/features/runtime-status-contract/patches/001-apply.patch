+	response, err := service.Query(context.Background(), Request{
+		SchemaVersion: SchemaVersion,
+		Queries: []Query{
+			{QueryID: "a", Path: "/repo", RepoRoot: "/repo", GitBranch: "feature/a", Metadata: metadata},
